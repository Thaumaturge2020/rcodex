#!/bin/bash
set -euo pipefail

LAUNCH_DIR="$(pwd -P)"
GLOBAL_STATE="${RCODEX_GLOBAL_STATE:-$HOME/.rcodex}"
PROJECT_STATE="${RCODEX_STATE_DIR:-$LAUNCH_DIR/.rcodex}"
if [ -n "${RCODEX_CONFIG:-}" ]; then
  CONF="$RCODEX_CONFIG"
elif [ -f "$PROJECT_STATE/config.sh" ]; then
  CONF="$PROJECT_STATE/config.sh"
else
  CONF="$GLOBAL_STATE/config.sh"
fi
[ -f "$CONF" ] || { echo "rcodex: missing config $CONF (copy config.example.sh there)"; exit 1; }
# shellcheck disable=SC1090
source "$CONF"

: "${REMOTE_HOST:?set REMOTE_HOST in $CONF}"
: "${REMOTE_DIR:?set REMOTE_DIR in $CONF}"
: "${LOCAL_MOUNT:?set LOCAL_MOUNT in $CONF}"
RCODEX_INIT="${RCODEX_INIT:-}"
RCODEX_SSH_EXTRA="${RCODEX_SSH_EXTRA:-}"
RCODEX_SSH_COMMAND="${RCODEX_SSH_COMMAND:-ssh}"
RCODEX_SSH_PROXY_JUMP="${RCODEX_SSH_PROXY_JUMP:-}"
RCODEX_SSH_PROXY_COMMAND="${RCODEX_SSH_PROXY_COMMAND:-}"
RCODEX_REMOTE_CODEX_HOME="${RCODEX_REMOTE_CODEX_HOME:-~/.codex}"

mkdir -p "$GLOBAL_STATE" "$PROJECT_STATE"
safe=$(printf '%s' "$REMOTE_HOST" | tr -c 'A-Za-z0-9_.-' '_')
CTL="$GLOBAL_STATE/cm-$safe.sock"

# shellcheck disable=SC2206
SSH_CMD=($RCODEX_SSH_COMMAND)
if [ "${#SSH_CMD[@]}" -eq 0 ]; then
  SSH_CMD=(ssh)
fi
if [ -z "${RCODEX_SSH_CONTROLMASTER+x}" ]; then
  case "${SSH_CMD[0]}" in
    ssh|*/ssh) RCODEX_SSH_CONTROLMASTER="auto" ;;
    *) RCODEX_SSH_CONTROLMASTER="no" ;;
  esac
fi

SSH_ARGS=()
if [ "$RCODEX_SSH_CONTROLMASTER" != "no" ]; then
  SSH_ARGS+=(-o "ControlMaster=$RCODEX_SSH_CONTROLMASTER" -o "ControlPath=$CTL" -o ControlPersist=10m)
fi
if [ -n "$RCODEX_SSH_PROXY_JUMP" ]; then
  SSH_ARGS+=(-J "$RCODEX_SSH_PROXY_JUMP")
fi
if [ -n "$RCODEX_SSH_PROXY_COMMAND" ]; then
  SSH_ARGS+=(-o "ProxyCommand=$RCODEX_SSH_PROXY_COMMAND")
fi
EXTRA_ARGS=()
if [ -n "$RCODEX_SSH_EXTRA" ]; then
  # Keep this simple on purpose. Put complex SSH settings in ~/.ssh/config.
  # shellcheck disable=SC2206
  EXTRA_ARGS=($RCODEX_SSH_EXTRA)
  SSH_ARGS+=("${EXTRA_ARGS[@]}")
fi

ssh_run() { "${SSH_CMD[@]}" "${SSH_ARGS[@]}" "$@"; }
ssh_control_enabled() { [ "$RCODEX_SSH_CONTROLMASTER" != "no" ]; }

sshfs_args=()
if [ "${SSH_CMD[*]}" != "ssh" ]; then
  sshfs_args+=(-o "ssh_command=${SSH_CMD[*]}")
fi
if ssh_control_enabled; then
  sshfs_args+=(-o "ControlMaster=$RCODEX_SSH_CONTROLMASTER" -o "ControlPath=$CTL" -o ControlPersist=10m)
fi
if [ -n "$RCODEX_SSH_PROXY_JUMP" ]; then
  sshfs_args+=(-o "ProxyJump=$RCODEX_SSH_PROXY_JUMP")
fi
if [ -n "$RCODEX_SSH_PROXY_COMMAND" ]; then
  sshfs_args+=(-o "ProxyCommand=$RCODEX_SSH_PROXY_COMMAND")
fi
sshfs_args+=("${EXTRA_ARGS[@]}")

SELF="$(cd "$(dirname "$0")" && pwd)"
SHIM_SRC="$SELF/remote-bash"
[ -x "$SHIM_SRC" ] || { echo "rcodex: cannot find executable remote-bash next to launcher"; exit 1; }

is_mounted() {
  if command -v mountpoint >/dev/null 2>&1; then
    mountpoint -q "$LOCAL_MOUNT"
  elif command -v findmnt >/dev/null 2>&1; then
    findmnt -rn --mountpoint "$LOCAL_MOUNT" >/dev/null 2>&1
  else
    mount 2>/dev/null | grep -Fq " on $LOCAL_MOUNT "
  fi
}

master_up() {
  ssh_control_enabled || return 1
  ssh_run -O check "$REMOTE_HOST" >/dev/null 2>&1
}

ensure_master() {
  ssh_control_enabled || return 0
  if master_up; then return 0; fi
  ssh_run -fN "$REMOTE_HOST" || {
    echo "rcodex: cannot establish SSH master to $REMOTE_HOST" >&2
    return 1
  }
}

ensure_mount() {
  if is_mounted; then return 0; fi
  command -v sshfs >/dev/null || { echo "rcodex: sshfs not installed"; exit 1; }
  mkdir -p "$LOCAL_MOUNT"
  sshfs "$REMOTE_HOST:$REMOTE_DIR" "$LOCAL_MOUNT" \
    -o reconnect -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
    -o follow_symlinks "${sshfs_args[@]}"
}

umount_all() {
  if is_mounted; then
    fusermount -u "$LOCAL_MOUNT" 2>/dev/null || umount "$LOCAL_MOUNT" 2>/dev/null || true
  fi
  if ssh_control_enabled; then
    ssh_run -O exit "$REMOTE_HOST" 2>/dev/null || true
  fi
  echo "rcodex: unmounted and closed SSH master"
}

setup_shim() {
  local d="$GLOBAL_STATE/shim"
  mkdir -p "$d"
  ln -sf "$SHIM_SRC" "$d/bash"
  ln -sf "$SHIM_SRC" "$d/sh"
  printf '%s' "$d"
}

setup_codex_home() {
  CH="${RCODEX_CODEX_HOME:-$PROJECT_STATE/codex-home}"
  mkdir -p "$CH"
  if [ -e "$HOME/.codex/auth.json" ]; then
    ln -sf "$HOME/.codex/auth.json" "$CH/auth.json"
  fi
  if [ ! -f "$CH/config.toml" ]; then
    cat > "$CH/config.toml" <<'TOML'
# rcodex keeps Codex auth, sessions, and logs local in this CODEX_HOME.
# Project files are seen through sshfs, and shell commands are forwarded by
# the bash/sh shim to the remote host.
sandbox_mode = "danger-full-access"
approval_policy = "never"
cli_auth_credentials_store = "auto"
TOML
  fi
  grep -Eq '^[[:space:]]*sandbox_mode[[:space:]]*=' "$CH/config.toml" || \
    printf '%s\n' 'sandbox_mode = "danger-full-access"' >> "$CH/config.toml"
  grep -Eq '^[[:space:]]*approval_policy[[:space:]]*=' "$CH/config.toml" || \
    printf '%s\n' 'approval_policy = "never"' >> "$CH/config.toml"
  grep -Eq '^[[:space:]]*cli_auth_credentials_store[[:space:]]*=' "$CH/config.toml" || \
    printf '%s\n' 'cli_auth_credentials_store = "auto"' >> "$CH/config.toml"
  export CODEX_HOME="$CH"
}

export_remote_env() {
  export RCODEX_HOST="$REMOTE_HOST"
  export RCODEX_DIR="$REMOTE_DIR"
  export RCODEX_INIT
  export RCODEX_SSH_CONTROL_PATH="$CTL"
  export RCODEX_SSH_EXTRA
  export RCODEX_SSH_COMMAND
  export RCODEX_SSH_CONTROLMASTER
  export RCODEX_SSH_PROXY_JUMP
  export RCODEX_SSH_PROXY_COMMAND
}

doctor() {
  local ok=1
  local remote_prefix='if printf dA== | base64 -d >/dev/null 2>&1; then b64d="base64 -d"; else b64d="base64 -D"; fi'
  echo "rcodex doctor"
  echo "launch: $LAUNCH_DIR"
  echo "config: $CONF"
  echo "state:  $PROJECT_STATE"
  echo "remote: $REMOTE_HOST:$REMOTE_DIR"
  echo "mount:  $LOCAL_MOUNT"
  echo "ssh:    ${SSH_CMD[*]}"
  [ -n "$RCODEX_SSH_PROXY_JUMP" ] && echo "jump:   $RCODEX_SSH_PROXY_JUMP"
  [ -n "$RCODEX_SSH_PROXY_COMMAND" ] && echo "proxy:  $RCODEX_SSH_PROXY_COMMAND"

  if command -v "${SSH_CMD[0]}" >/dev/null 2>&1 || [ -x "${SSH_CMD[0]}" ]; then
    echo "ok:     ssh command (${SSH_CMD[*]})"
  else
    echo "missing: ssh command ${SSH_CMD[0]}"
    ok=0
  fi
  for cmd in sshfs codex base64; do
    if command -v "$cmd" >/dev/null 2>&1; then
      echo "ok:     $cmd ($(command -v "$cmd"))"
    else
      echo "missing: $cmd"
      ok=0
    fi
  done

  setup_codex_home
  echo "codex:  $CODEX_HOME"
  [ -x "$SHIM_SRC" ] && echo "ok:     remote-bash executable" || { echo "missing: executable remote-bash next to rcodex"; ok=0; }
  [ -e "$CODEX_HOME/auth.json" ] && echo "ok:     local auth.json linked/found" || echo "note:   no auth.json in $CODEX_HOME; keyring auth may still work, otherwise run CODEX_HOME=$CODEX_HOME codex login"

  if ! command -v "${SSH_CMD[0]}" >/dev/null 2>&1 && [ ! -x "${SSH_CMD[0]}" ]; then
    echo "fail:   ssh command is required for remote checks"
    ok=0
  elif ssh_run "$REMOTE_HOST" 'command -v bash >/dev/null && command -v base64 >/dev/null' >/dev/null 2>&1; then
    echo "ok:     remote has bash and base64"
  else
    echo "fail:   cannot run bash/base64 check on remote"
    ok=0
  fi

  local dir_b64
  dir_b64=$(printf '%s' "$REMOTE_DIR" | base64 | tr -d '\n')
  if ssh_run "$REMOTE_HOST" "$remote_prefix; d=\$(printf %s $dir_b64 | \$b64d); [ -d \"\$d\" ]" >/dev/null 2>&1; then
    echo "ok:     remote directory exists"
  else
    echo "fail:   remote directory does not exist or is not accessible"
    ok=0
  fi

  is_mounted && echo "ok:     mounted" || echo "note:   not mounted"
  [ "$ok" -eq 1 ]
}

count_session_files() {
  local d="$1"
  if [ -d "$d" ]; then
    find "$d" -type f -name '*.jsonl' | wc -l | tr -d ' '
  else
    printf '0'
  fi
}

sanitize_session_jsonl() {
  local root="$1"
  local sanitized_count=0
  local changed

  [ -d "$root" ] || return 0
  while IFS= read -r -d '' f; do
    changed=$(perl -MJSON::PP -e '
      use strict;
      use warnings;

      sub looks_opaque {
        my ($s) = @_;
        return defined($s) && length($s) >= 80 && $s =~ /\A[A-Za-z0-9+\/=_-]+\z/;
      }

      sub rewrite_paths {
        my ($value, $key) = @_;
        my $remote = $ENV{RCODEX_SYNC_REMOTE_DIR} // "";
        my $local = $ENV{RCODEX_SYNC_LOCAL_MOUNT} // "";
        my $changed = 0;

        if (ref($value) eq "HASH") {
          for my $child_key (keys %$value) {
            my $child = $value->{$child_key};
            if (ref($child)) {
              $changed += rewrite_paths($child, $child_key);
            } elsif (defined($child) && $remote ne "" && index($child, $remote) >= 0) {
              next if $child_key eq "encrypted_content" && looks_opaque($child);
              $child =~ s/\Q$remote\E/$local/g;
              $value->{$child_key} = $child;
              $changed++;
            }
          }
        } elsif (ref($value) eq "ARRAY") {
          for my $idx (0 .. $#$value) {
            my $child = $value->[$idx];
            if (ref($child)) {
              $changed += rewrite_paths($child, $key);
            } elsif (defined($child) && $remote ne "" && index($child, $remote) >= 0) {
              $child =~ s/\Q$remote\E/$local/g;
              $value->[$idx] = $child;
              $changed++;
            }
          }
        }

        return $changed;
      }

      my $file = shift @ARGV;
      my $json = JSON::PP->new->utf8;
      open my $in, "<:raw", $file or die "open $file: $!";
      my @out;
      my $changed = 0;

      while (defined(my $line = <$in>)) {
        my $orig = $line;
        $line =~ s/\r?\n\z//;
        my $obj = eval { $json->decode($line) };
        if ($@ || ref($obj) ne "HASH") {
          push @out, $orig;
          next;
        }

        my $line_changed = rewrite_paths($obj, undef);
        if (($obj->{type} // "") eq "compacted") {
          my $payload = $obj->{payload};
          my $history = ref($payload) eq "HASH" ? $payload->{replacement_history} : undef;
          if (ref($history) eq "ARRAY") {
            for my $item (@$history) {
              next unless ref($item) eq "HASH";
              next unless ($item->{type} // "") eq "compaction";
              next unless exists $item->{encrypted_content};
              my $content = defined($item->{encrypted_content}) ? $item->{encrypted_content} : "";
              next if looks_opaque($content);
              %$item = (
                type => "message",
                role => "user",
                content => [{
                  type => "input_text",
                  text => "Imported Codex compaction summary from a migrated session:\n\n$content",
                }],
              );
              $line_changed = 1;
              $changed++;
            }
          }
        }

        push @out, $line_changed ? $json->encode($obj) . "\n" : $orig;
      }
      close $in;

      if ($changed) {
        open my $out, ">:raw", $file or die "write $file: $!";
        print {$out} @out;
        close $out;
      }
      print "$changed\n";
    ' "$f")
    sanitized_count=$((sanitized_count + changed))
  done < <(find "$root" -type f -name '*.jsonl' -print0)

  if [ "$sanitized_count" -gt 0 ]; then
    echo "rcodex sync: normalized $sanitized_count plaintext compaction item(s)"
  fi
}

print_sync_help() {
  cat <<'EOF'
rcodex sync - import remote Codex sessions into the local rcodex CODEX_HOME

Usage:
  rcodex sync [options]

Options:
  --from PATH       Remote Codex home to import from (default: ~/.codex)
  --all             Import all remote sessions instead of filtering by REMOTE_DIR
  --with-history    Also merge remote history.jsonl into local history.jsonl
  --dry-run         Show what would be imported without writing local sessions
  -h, --help        Show this help

Default behavior:
  - copies remote sessions/ into ./.rcodex/codex-home/sessions
  - keeps only sessions whose recorded cwd starts with REMOTE_DIR
  - rewrites REMOTE_DIR in imported rollout files to LOCAL_MOUNT
  - normalizes plaintext compaction summaries so resumed sessions do not send
    them as encrypted reasoning content
  - does not copy remote auth.json, config.toml, sqlite state, or logs
EOF
}

sync_sessions() {
  local remote_home="$RCODEX_REMOTE_CODEX_HOME"
  local import_all=0
  local with_history=0
  local dry_run=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --from|--remote-home)
        shift
        remote_home="${1:?rcodex sync: --from requires a remote path}"
        ;;
      --all) import_all=1 ;;
      --with-history) with_history=1 ;;
      --dry-run) dry_run=1 ;;
      -h|--help) print_sync_help; return 0 ;;
      *)
        echo "rcodex sync: unknown option $1" >&2
        echo "try: rcodex sync --help" >&2
        return 2
        ;;
    esac
    shift
  done

  for cmd in tar perl awk; do
    command -v "$cmd" >/dev/null 2>&1 || {
      echo "rcodex sync: missing local dependency: $cmd" >&2
      return 1
    }
  done
  perl -MJSON::PP -e '1' >/dev/null 2>&1 || {
    echo "rcodex sync: missing local Perl module: JSON::PP" >&2
    return 1
  }

  ensure_master
  setup_codex_home

  local tmp
  tmp=$(mktemp -d "$PROJECT_STATE/sync.XXXXXX")
  trap 'rm -rf "$tmp"' RETURN

  local remote_prefix remote_home_b64 remote_cmd
  remote_prefix='if printf dA== | base64 -d >/dev/null 2>&1; then b64d="base64 -d"; else b64d="base64 -D"; fi'
  remote_home_b64=$(printf '%s' "$remote_home" | base64 | tr -d '\n')
  remote_cmd="$remote_prefix; src=\$(printf %s $remote_home_b64 | \$b64d); if [ \"\$src\" = '~' ]; then src=\$HOME; elif [ \"\${src#\\~/}\" != \"\$src\" ]; then src=\"\$HOME/\${src#\\~/}\"; fi; [ -d \"\$src\" ] || { echo \"rcodex sync: remote Codex home not found: \$src\" >&2; exit 10; }; command -v tar >/dev/null 2>&1 || { echo \"rcodex sync: remote tar not found\" >&2; exit 11; }; cd \"\$src\"; set --; [ -d sessions ] && set -- \"\$@\" sessions; [ -f history.jsonl ] && set -- \"\$@\" history.jsonl; [ \"\$#\" -gt 0 ] || { echo \"rcodex sync: no sessions/history found in \$src\" >&2; exit 12; }; tar -cf - \"\$@\""

  echo "rcodex sync: source $REMOTE_HOST:$remote_home"
  echo "rcodex sync: target $CODEX_HOME"
  if [ "$import_all" -eq 0 ]; then
    echo "rcodex sync: filtering sessions by remote cwd prefix $REMOTE_DIR"
  else
    echo "rcodex sync: importing all remote sessions"
  fi

  if ! ssh_run "$REMOTE_HOST" "$remote_cmd" > "$tmp/remote.tar"; then
    echo "rcodex sync: failed to read remote Codex sessions" >&2
    return 1
  fi
  if ! tar -xf "$tmp/remote.tar" -C "$tmp"; then
    echo "rcodex sync: failed to unpack remote Codex sessions" >&2
    return 1
  fi
  rm -f "$tmp/remote.tar"

  local total matched local_mount
  total=$(count_session_files "$tmp/sessions")

  if [ -d "$tmp/sessions" ] && [ "$import_all" -eq 0 ]; then
    while IFS= read -r -d '' f; do
      if ! grep -Fq "\"cwd\":\"$REMOTE_DIR" "$f"; then
        rm -f "$f"
      fi
    done < <(find "$tmp/sessions" -type f -name '*.jsonl' -print0)
    find "$tmp/sessions" -type d -empty -delete 2>/dev/null || true
  fi

  matched=$(count_session_files "$tmp/sessions")
  local_mount="$LOCAL_MOUNT"
  case "$local_mount" in
    /*) ;;
    *) local_mount="$LAUNCH_DIR/$local_mount" ;;
  esac

  if [ -d "$tmp/sessions" ]; then
    RCODEX_SYNC_REMOTE_DIR="$REMOTE_DIR" \
    RCODEX_SYNC_LOCAL_MOUNT="$local_mount" \
      sanitize_session_jsonl "$tmp/sessions"
  fi

  echo "rcodex sync: remote session files: $total"
  echo "rcodex sync: matching session files: $matched"

  if [ "$dry_run" -eq 1 ]; then
    [ "$with_history" -eq 1 ] && [ -f "$tmp/history.jsonl" ] && \
      echo "rcodex sync: would merge history.jsonl"
    echo "rcodex sync: dry run complete"
    return 0
  fi

  if [ "$matched" -gt 0 ]; then
    mkdir -p "$CODEX_HOME/sessions"
    cp -a "$tmp/sessions/." "$CODEX_HOME/sessions/"
  fi

  if [ "$with_history" -eq 1 ] && [ -f "$tmp/history.jsonl" ]; then
    touch "$CODEX_HOME/history.jsonl"
    local hist_tmp
    hist_tmp="$tmp/history.jsonl.merged"
    awk '!seen[$0]++' "$CODEX_HOME/history.jsonl" "$tmp/history.jsonl" > "$hist_tmp"
    mv "$hist_tmp" "$CODEX_HOME/history.jsonl"
    echo "rcodex sync: merged history.jsonl"
  fi

  echo "rcodex sync: import complete"
}

print_help() {
  cat <<'EOF'
rcodex - run Codex locally and execute shell commands on a remote host

Usage:
  rcodex [codex options] [prompt]
  rcodex exec [codex exec options] "prompt"
  rcodex resume [codex resume options]

rcodex commands:
  --doctor       Check local tools, SSH transport, remote bash/base64, and REMOTE_DIR
  --mount        Mount REMOTE_HOST:REMOTE_DIR at LOCAL_MOUNT
  --status       Show mount and SSH master status
  --shell        Open a raw remote shell in REMOTE_DIR
  sync           Import remote Codex sessions into local rcodex CODEX_HOME
  --umount       Unmount LOCAL_MOUNT and close the SSH master when enabled
  --stop         Alias for --umount
  -h, --help     Show this help

Permission aliases:
  --dangerous-access
      Alias for Codex's --dangerously-bypass-approvals-and-sandbox.
      rcodex already creates a project-local Codex config with
      sandbox_mode="danger-full-access" and approval_policy="never".

Pass-through:
  All other arguments are passed to codex after rcodex mounts the remote
  directory and sets CODEX_HOME.

Examples:
  rcodex
  rcodex "inspect this project"
  rcodex exec "run the tests"
  rcodex resume --last
  rcodex sync
  rcodex -- --help
EOF
}

case "${1:-}" in
  -h|--help) print_help; exit 0 ;;
  sync|sync-sessions|import-sessions) shift; sync_sessions "$@"; exit $? ;;
  --umount|--stop) umount_all; exit 0 ;;
  --mount) ensure_master; ensure_mount; echo "rcodex: mounted $REMOTE_HOST:$REMOTE_DIR -> $LOCAL_MOUNT"; exit 0 ;;
  --doctor) doctor; exit $? ;;
  --status)
    is_mounted && echo "mount:  UP ($LOCAL_MOUNT)" || echo "mount:  down"
    if ssh_control_enabled; then
      ssh_run -O check "$REMOTE_HOST" 2>&1 | sed 's/^/master: /' || true
    else
      echo "master: disabled"
    fi
    exit 0 ;;
  --) shift ;;
esac

ensure_master
ensure_mount
setup_codex_home
export_remote_env

shimdir="$(setup_shim)"
cd "$LOCAL_MOUNT"
export PATH="$shimdir:$PATH"
if [ "${1:-}" = "--shell" ]; then
  shift
  exec "$SHIM_SRC" "$@"
fi
command -v codex >/dev/null || { echo "rcodex: codex not found in PATH"; exit 1; }
CODEX_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --dangerous-access) CODEX_ARGS+=(--dangerously-bypass-approvals-and-sandbox) ;;
    *) CODEX_ARGS+=("$arg") ;;
  esac
done
exec codex "${CODEX_ARGS[@]}"
